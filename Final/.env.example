# Copy to .env and fill in. Never commit .env.

# App
APP_NAME=CareerMirror
LOG_LEVEL=INFO

# Auth: JWT_SECRET must be at least 32 characters
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=8
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage. Postgres runs in the `db` container; docker compose builds DATABASE_URL
# from the POSTGRES_* values, so DATABASE_URL here is only for running the api outside docker.
POSTGRES_USER=careermirror
POSTGRES_PASSWORD=
POSTGRES_DB=careermirror
DATABASE_URL=postgresql+asyncpg://careermirror:<password>@localhost:5432/careermirror
RAG_DB_PATH=./var/rag.db
DATA_DIR=../data

# Retrieval
EMBED_MODEL=intfloat/multilingual-e5-base

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=30
LLM_ROUTER_ATTEMPT_TIMEOUT_S=7
# Optional: Jev in the router's LLM layer. Messages and recent turns go to TypeSafe (US).
JEV_ROUTER_ENABLED=false
TYPESAFE_API_KEY=
JEV_TIMEOUT_S=3

# Daily quota per user (FR-23)
QUOTA_DAILY_REQUESTS=40
QUOTA_DAILY_TOKENS=40000
QUOTA_TZ=Asia/Bangkok

# Profile generation gate (FR-14)
COMPLETENESS_THRESHOLD=65

# Role matching (FR-19)
MATCH_THRESHOLD=60
TOP_N_ROLES=5

# Market data cache (FR-22)
CACHE_MAX_AGE_DAYS=7
REFRESH_DAILY_CAP=20
APIFY_TOKEN=
APIFY_JOBTHAI_ACTOR=

# Groq account limits per model per day (Design 4.7), shown on the admin dashboard
GROQ_DAILY_TOKEN_LIMIT=200000
GROQ_DAILY_REQUEST_LIMIT=1000

# Admin dashboard (FR-40 to FR-45): comma-separated emails of the team members
ADMIN_EMAILS=
ADMIN_WARN_LLM_PCT=80
ADMIN_WARN_ERROR_PCT=5
LOG_RETENTION_DAYS=30
APIFY_WEEKLY_BUDGET=26

# web
API_BASE_URL=http://api:8000
