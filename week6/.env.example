# =====================================================================
# .env.example — Team D / DL-07 Agentic AI System II
#
# ตัวแปรทั้งหมดถอดมาจากหัวข้อ "Required configuration" ในแผนของอาจารย์
# (DL-07-Agentic-AI-System-II/*/01_env.txt)
#
# วิธีใช้:  cp .env.example .env   แล้วเติมค่าจริงในไฟล์ .env
# ห้าม commit .env  (.gitignore กันไว้แล้ว) — ไฟล์นี้ต้องมีแต่ค่าว่าง/ค่าตัวอย่าง
# =====================================================================

# --------------------------------------------------- 01_web_app (Next.js)
# NEXT_PUBLIC_* ถูกฝังลงใน bundle ฝั่ง browser → ใส่ได้แค่ค่าที่เปิดเผยได้
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
DEFAULT_LOCALE=th-TH
DEFAULT_TIMEZONE=Asia/Bangkok

# ------------------------------------------------ 02_api_backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/teamd
REDIS_URL=redis://localhost:6379/0
# ค่าของ Keycloak ที่ใช้ร่วมกัน (identity/README.md)
JWT_ISSUER=http://localhost:8180/realms/travel-safety
JWT_AUDIENCE=travel-safety-api
AGENT_SERVICE_URL=http://localhost:8010
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# ------------------------------------------------- 03_travel_ai_agent
LLM_MODEL_PLANNER=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=16
AGENT_TOTAL_TIMEOUT=60
PROMPT_VERSION=v1
POLICY_VERSION=v1
# service URL ของโมดูลอื่นที่ agent เรียก
EXTERNAL_DATA_SERVICE_URL=http://localhost:8020
INTEGRATION_SERVICE_URL=http://localhost:8030
RISK_SERVICE_URL=http://localhost:8040
RAG_SERVICE_URL=http://localhost:8041
ROUTE_SERVICE_URL=http://localhost:8042
DECISION_SERVICE_URL=http://localhost:8050

# -------------------------------------------- 04_external_data_services
# คีย์จริงห้ามใส่ที่นี่ — ใช้ test key ตอน dev ตามที่แผนระบุ
WEATHER_API_KEY=
TRANSPORT_API_KEY=
DISASTER_API_KEY=
PROVIDER_TIMEOUT=10
CACHE_TTL=300
RATE_LIMIT=60
USER_AGENT=TeamD-DL07/0.1 (course project)

# ------------------------------------------------- 05_data_integration
EVENT_BROKER_URL=
CANONICAL_SCHEMA_VERSION=v1
DEFAULT_CRS=EPSG:4326

# -------------------------------------- 06_risk_knowledge_services
MODEL_URI=
MODEL_VERSION=
FEATURE_SCHEMA_VERSION=v1
EMBEDDING_MODEL=
COLLECTION_VERSION=v1
TOP_K=20
RERANK_TOP_N=5
RISK_THRESHOLDS=
ROUTE_BUFFER_KM=5
KNOWLEDGE_CUTOFF=

# ------------------------------------------- 07_decision_llm_engine
LLM_MODEL_EXPLAINER=
TEMPERATURE=0
DECISION_POLICY_VERSION=v1
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT=30
ESCALATION_RULES=
SUPPORTED_LOCALES=th-TH,en-US

# --------------------------------------- 08_recommendation_feedback
RECOMMENDATION_SCHEMA_VERSION=v1
FEEDBACK_RETENTION_DAYS=180
ALERT_REFRESH_INTERVAL=60
NOTIFICATION_PROVIDER_KEYS=
EMERGENCY_CONTACT_DIRECTORY_VERSION=v1

# ---------------------------- Keycloak (root docker-compose.yml, ใช้ร่วมกัน)
# ค่าตัวอย่างสำหรับ dev เท่านั้น — ถ้าเปลี่ยน password/secret หลังเปิดครั้งแรก
# ต้อง `docker compose down -v` เพราะ realm import แค่ครั้งแรก
KC_HOST_PORT=8180
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin-dev-change-me
KC_DEV_USER_PASSWORD=dev-password-change-me
KC_OPS_ADMIN_SECRET=ops-admin-dev-secret-change-me

# ------------------------------------ 08_monitoring (docker compose)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
