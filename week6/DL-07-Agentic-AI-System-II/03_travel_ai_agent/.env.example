# Copy to .env for local development. Never commit real credentials.
AGENT_VERSION=0.1.0
PROMPT_VERSION=rules-v1
# Must equal AGENT_SERVICE_TOKEN in Module 02. Empty disables auth (local dev only).
AGENT_SERVICE_TOKEN=
DECISION_SERVICE_URL=http://localhost:8050
# false: real Module 04 (weather, transport, disaster, routing) + Module 05
# integration + Module 06.
USE_MOCK_TOOLS=false
# Transport provider: "longdo" (Longdo Traffic / iTIC Thailand) or "tomtom" (TomTom Orbis)
TRANSPORT_PROVIDER=longdo
LONGDO_API_KEY=
# Required for live TomTom transport if TRANSPORT_PROVIDER=tomtom; without it transport reports "unavailable"
# (not a route failure, but it does lower quality/confidence). GDACS and Open-Meteo
# need no key.
TOMTOM_API_KEY=
# Disaster provider: "thai" (DDPM / data.go.th / TMD) or "gdacs" or "both"
DISASTER_PROVIDER=thai
THAI_DISASTER_MOCK_FALLBACK=true
# Optional API endpoint or token for data.go.th / DDPM
THAI_DISASTER_API_URL=
DATA_GO_TH_API_KEY=
DATA_GO_TH_DISASTER_RESOURCE_ID=
# Public OSRM demo server: no key, but rate limited and unsuitable for production
# load. Point this at a self-hosted OSRM instance for real deployments.
OSRM_BASE_URL=https://router.project-osrm.org
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
AGENT_TOTAL_TIMEOUT=60
TOOL_TIMEOUT_SECONDS=5
DECISION_MAX_ATTEMPTS=2
# Planned for the LLM planner (not used yet):
# LLM_MODEL_PLANNER=
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=10
AGENT_HOST_PORT=8010
