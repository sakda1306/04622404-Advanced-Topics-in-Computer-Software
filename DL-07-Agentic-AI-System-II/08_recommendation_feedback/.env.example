# Copy this file to .env before running `docker compose up`.
# .env should NOT be committed to git (add it to .gitignore).

# --- Postgres ---
POSTGRES_USER=reco_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=reco_db

# Used by the app container. Host must match the compose service name
# ("postgres" / "redis"), not localhost, because containers talk to each
# other over the Docker network by service name.
DATABASE_URL=postgresql+asyncpg://reco_user:change_me@postgres:5432/reco_db
REDIS_URL=redis://redis:6379/0

# --- Required configuration (see 01_env.txt) ---
RECOMMENDATION_SCHEMA_VERSION=1.0.0
FEEDBACK_RETENTION_DAYS=180
ALERT_REFRESH_INTERVAL_SECONDS=60
NOTIFICATION_PROVIDER_KEYS=
EMERGENCY_CONTACT_DIRECTORY_VERSION=1.0.0
FEATURE_FLAG_LIVE_UPDATES=true
ROLLOUT_PERCENTAGE=100

SERVICE_PORT=8080
DECISION_ENGINE_URL=http://decision-engine:8050
DECISION_ENGINE_TIMEOUT_SECONDS=10.0
