# Copy to .env for local development. Never commit real credentials.
DECISION_POLICY_VERSION=prototype-v3
# The bundled prototype policy cannot be approved by changing this flag.
POLICY_APPROVED=false
PROMPT_VERSION=v1
# Optional LLM Explainer (Google Gemini REST provider):
# Set LLM_API_KEY (or GEMINI_API_KEY) and LLM_MODEL_EXPLAINER to enable.
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_EXPLAINER=disabled
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
TEMPERATURE=0
MAX_INPUT_TOKENS=8000
MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT=5.0
LLM_MAX_ATTEMPTS=2
SUPPORTED_LOCALES=th-TH,en-US
ESCALATION_RULES=missing,stale,conflicting,incomplete,low_confidence,unverified_warning,partial,freshness_unknown
# Local Python path; Compose deliberately uses /app/data/audit.jsonl instead.
AUDIT_LOG_PATH=data/audit.jsonl
DECISION_HOST_PORT=8050
# Optional local reviewed catalog; omit to use bundled fallback-only catalog.
# EMERGENCY_CATALOG_PATH=/absolute/path/to/reviewed-catalog.json
