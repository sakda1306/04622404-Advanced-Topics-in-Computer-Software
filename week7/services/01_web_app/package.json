{
  "name": "football-assistant-web",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/integration-harness.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm format:check && pnpm build",
    "format:check": "prettier --check app components lib tests \"scripts/*.mjs\""
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
