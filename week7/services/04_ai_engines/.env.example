# Groq — หลัก (CONTRACT.md §8)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini — สำรอง
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# timeout ต่อ provider (วินาที) — รวมกันต้องอยู่ในงบ 20s ที่ router ตั้งไว้
GENERAL_PRIMARY_TIMEOUT_SECONDS=7
GENERAL_FALLBACK_TIMEOUT_SECONDS=6

# เพดาน token กันหลุดของ /general (จะปรับจริงจังใน D4)
GENERAL_MAX_TOKENS=350
GENERAL_MAX_INPUT_TOKENS=1200

# ใส่โดย CI/build เพื่อโชว์ version ใน /health (ไม่บังคับ)
GIT_SHA=
