# Local demonstration only. Copy to .env and replace passwords before sharing the stack.
POSTGRES_PASSWORD=change-this-local-postgres-password
JWT_SECRET_KEY=replace-this-with-at-least-32-random-characters
SEED_ADMIN_PASSWORD=change-this-local-admin-password
SEED_DEMO_PASSWORD=change-this-local-demo-password

# External providers; leave blank only when testing no-provider fallback paths.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=90
REPORT_AUTO_PUBLISH=false
# Send squad/player documents to retrieval (05). Needs CONTRACT v1.5 support in 05 and 03.
PLAYER_INDEX_ENABLED=false
COACH_INDEX_ENABLED=false
LLM_MOCK=false
# Router rewrites follow-up chat questions with the LLM before routing (CONTRACT v1.8).
ROUTER_CONDENSE_ENABLED=true
# Small, fast model for that rewrite; blank uses GROQ_MODEL / GEMINI_MODEL.
GROQ_CONDENSE_MODEL=qwen/qwen3.8-27b
GEMINI_CONDENSE_MODEL=
# Router also searches Thai questions with an English query from the same small model (CONTRACT v1.9).
ROUTER_MULTI_QUERY_ENABLED=true
ROUTER_CHAT_ENABLED=true
ROUTER_CHAT_TIMEOUT=6
